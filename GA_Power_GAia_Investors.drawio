<mxfile host="app.diagrams.net"><diagram id="ga-power" name="Grupa Azoty: the power + GAia"><mxGraphModel dx="1920" dy="1080" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v1" value="&lt;b style=&quot;letter-spacing:3px&quot;&gt;GRUPA AZOTY · INVESTOR VIEW&lt;/b&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontColor=#1F5F99;fontSize=14;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="26" width="1300" height="22" as="geometry"/></mxCell><mxCell id="v2" value="&lt;b&gt;THE MACHINE IS BUILT. GAia IS ITS BRAIN.&lt;/b&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontColor=#183349;fontSize=40;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1300" height="50" as="geometry"/></mxCell><mxCell id="v3" value="Europe&#x27;s #2 fertilizer group runs the entire chain itself, from its own raw materials to 68 distributors. &lt;b&gt;The one link it does not own is the farmer&#x27;s demand data.&lt;/b&gt; GAia closes the loop." style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontColor=#1E1E1E;fontSize=16;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="102" width="1300" height="40" as="geometry"/></mxCell><mxCell id="v4" value="&lt;div style=&quot;text-align:left;padding:0 18px&quot;&gt;&lt;span style=&quot;font-size:12px;letter-spacing:2px;color:#BFE6D4&quot;&gt;&lt;b&gt;THE PRIZE&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:34px&quot;&gt;&lt;b&gt;+PLN 0.78 bn&lt;/b&gt;&lt;/span&gt;&lt;span style=&quot;font-size:15px&quot;&gt; revenue / year&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;AN/CAN 45% → 60% · NPK 42% → 60% · 1 p.p. AN/CAN ≈ PLN 39 m&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;fillColor=#1F7A5A;strokeColor=none;fontColor=#FFFFFF;align=left;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1370" y="26" width="510" height="118" as="geometry"/></mxCell><mxCell id="v5" value="" style="rounded=1;arcSize=2;fillColor=#F3F4F5;strokeColor=#D5DBE0;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="162" width="1840" height="498" as="geometry"/></mxCell><mxCell id="v6" value="&lt;b style=&quot;letter-spacing:2px&quot;&gt;PHYSICAL VALUE CHAIN&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;color:#5B6B76&quot;&gt;built · owned · paid for&lt;/span&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontColor=#183349;fontSize=14;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="60" y="170" width="1200" height="26" as="geometry"/></mxCell><mxCell id="v7" value="&lt;div style=&quot;text-align:left;padding:0 16px&quot;&gt;&lt;span style=&quot;font-size:12px;letter-spacing:2px;color:#9FC3E6&quot;&gt;&lt;b&gt;01 · RAW MATERIALS&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:36px&quot;&gt;&lt;b&gt;S · P · NH₃&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#BFE6D4&quot;&gt;&lt;b&gt;own inputs&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;fillColor=#183349;strokeColor=none;fontColor=#FFFFFF;align=left;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="60" y="204" width="300" height="104" as="geometry"/></mxCell><mxCell id="v8" value="&lt;div style=&quot;text-align:left;padding:0 14px&quot;&gt;&lt;b style=&quot;font-size:15px;color:#183349&quot;&gt;Siarkopol&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#5B6B76&quot;&gt;own sulphur mine&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;fillColor=#FFFFFF;strok