<mxfile host="app.diagrams.net"><diagram id="ga-jedna-grupa" name="1. Jedna Grupa - luki i technologie"><mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1608" pageHeight="1380" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="infra" value="&lt;b&gt;ZINTEGROWANA INFRASTRUKTURA PRODUKCYJNO-LOGISTYCZNA&lt;/b&gt; — planowana jako jedna sieć, nie 6 osobnych zakładów" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;align=left;verticalAlign=top;spacingLeft=12;spacingTop=4;fontFamily=Helvetica;fontSize=13;fillColor=#F3F5F7;strokeColor=#536773;fontColor=#183349;strokeWidth=1.5;dashed=1;" vertex="1" parent="1"><mxGeometry x="26" y="694" width="1556" height="424" as="geometry"/></mxCell><mxCell id="title" value="&lt;b&gt;GRUPA AZOTY | Jedna Grupa, jeden system: co już jest, gdzie są luki, jak to połączyć&lt;/b&gt;&lt;br&gt;Centrala → kontroling → jeden system SAP → zintegrowana infrastruktura produkcyjno-logistyczna → rynek. Cel: z ~50% do 60% rynku nawozów w Polsce." style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;align=left;verticalAlign=top;spacing=10;fontFamily=Helvetica;fontSize=15;fillColor=#FFFFFF;strokeColor=#CBD5DF;fontColor=#183349;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1528" height="64" as="geometry"/></mxCell><mxCell id="dzis" value="&lt;b&gt;DZIŚ (D1 s.17):&lt;/b&gt; 4 ośrodki jak niezależne firmy · zdublowane funkcje · plan w Excelu · wynik per spółka · każdy zakład sam planuje magazyn i transport" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;align=left;verticalAlign=middle;spacing=10;fontFamily=Helvetica;fontSize=12;fillColor=#FDECEC;strokeColor=#B23A3A;fontColor=#183349;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="96" width="756.0" height="54" as="geometry"/></mxCell><mxCell id="cel" value="&lt;b&gt;DOCELOWO:&lt;/b&gt; centrala zarządza spółkami i systemami · 4 segmenty · jeden SAP i wspólne dane · jeden kontroling · produkcja, magazyny i logistyka planowane jak jedna sieć" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;align=left;verticalAlign=middle;spacing=10;fontFamily=Helvetica;fontSize=12;fillColor=#E8F5EE;strokeColor=#28794D;fontColor=#183349;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="812.0" y="96" width="756.0" height="54" as="geometry"/></mxCell><mxCell id="dc" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#183349;strokeWidth=2;fontSize=11;fontColor=#183349;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="dzis" target="cel"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="h0" value="&lt;b&gt;JEST W GRUPIE AZOTY → wykorzystać mocniej&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;align=center;verticalAlign=middle;spacing=10;fontFamily=Helvetica;fontSize=13;fillColor=#28794D;strokeColor=#28794D;fontColor=#FFFFFF;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="306" y="172" width="410" height="32" as="geometry"/></mxCell><mxCell id="h1" value="&lt;b&gt;LUKA (z dokumentów)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;align=center;verticalAlign=middle;spacing=10;fontFamily=Helvetica;fontSize=13;fillColor=#B23A3A;strokeColor=#B23A3A;fontColor=#FFFFFF;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="732" y="172" width="410" height="32" as="geometry"/></mxCell><mxCell id="h2" value="&lt;b&gt;JAK POŁĄCZYĆ&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;align=center;verticalAlign=middle;spacing=10;fontFamily=Helvetica;fontSize=13;fillColor=#286396;strokeColor=#286396;fontColor=#FFFFFF;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1158" y="172" width="410" height="32" as="geometry"/></mxCell><mxCell id="L_centrala" value="&lt;b&gt;CENTRALA GRUPY&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Warszawa (propozycja): zarządza spółkami, standardami i systemami&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;align=center;verticalAlign=middle;spacing=10;fontFamily=Helvetica;fontSize=14;fillColor=#183349;strokeColor=#183349;fontColor=#FFFFFF;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="216" width="250" height="140" as="geometry"/></mxCell><mxCell id="centrala_0" value="&lt;ul style='margin:0;padding-left:16px'&gt;&lt;li&gt;Strategia 2030 zakłada wzmocnienie centrali: zakupy, nadzór nad inwestycjami, B+R (D1 s.17)&lt;/li&gt;&lt;li&gt;Centrum Usług Wspólnych (CUW) dla funkcji wsparcia&lt;/li&gt;&lt;li&gt;Model 4 segmentów: Nawozy, Logistyka, Chemia dla obronności, Zaawansowana Chemia&lt;/li&gt;&lt;li&gt;Zapis o „jednolitej architekturze systemu IT” dla spójności danych&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;align=left;verticalAlign=top;spacing=10;fontFamily=Helvetica;fontSize=12;fillColor=#E8F5EE;strokeColor=#28794D;fontColor=#183349;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="306" y="216" width="410" height="140" as="geometry"/></mxCell><mxCell id="centrala_1" value="&lt;ul style='margin:0;padding-left:16px'&gt;&lt;li&gt;4 ośrodki działają jak niezależne podmioty&lt;/li&gt;&lt;li&gt;Zdublowane funkcje, np. księgowość w kilku zakładach&lt;/li&gt;&lt;li&gt;Wynik optymalizowany per spółka, nie per Grupa&lt;/li&gt;&lt;li&gt;Moce nie są alokowane względem popytu całej Grupy&lt;/li&gt;&lt;li&gt;Lokalizacja centrali w dokumentach nieokreślona (centrum korporacyjne: Tarnów)&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;align=left;verticalAlign=top;spacing=10;fontFamily=Helvetica;fontSize=12;fillColor=#FDECEC;strokeColor=#B23A3A;fontColor=#183349;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="732" y="216" width="410" height="140" as="geometry"/></mxCell><mxCell id="centrala_2" value="&lt;ul style='margin:0;padding-left:16px'&gt;&lt;li&gt;Centrala jest właścicielem: standardu procesów, danych podstawowych, architektury IT i licencji&lt;/li&gt;&lt;li&gt;Zatwierdza jeden plan segmentu Nawozy i alokację produkcji między zakładami&lt;/li&gt;&lt;li&gt;Spółki produkcyjne wykonują plan; nie konkurują ze sobą o klienta&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;align=left;verticalAlign=top;spacing=10;fontFamily=Helvetica;fontSize=12;fillColor=#E7F1FA;strokeColor=#286396;fontColor=#183349;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1158" y="216" width="410" height="140" as="geometry"/></mxCell><mxCell id="L_kontroling" value="&lt;b&gt;WARSTWA KONTROLINGU&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;jeden rachunek wyniku Grupy i segmentów&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;align=center;verticalAlign=middle;spacing=10;fontFamily=Helvetica;fontSize=14;fillColor=#A96512;strokeColor=#A96512;fontColor=#FFFFFF;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="370" width="250" height="156" as="geometry"/></mxCell><mxCell id="kontroling_0" value="&lt;ul style='margin:0;padding-left:16px'&gt;&lt;li&gt;SAP FI/CO w spółkach&lt;/li&gt;&lt;li&gt;Hurtownia danych i BI (zakres do audytu)&lt;/li&gt;&lt;li&gt;Biuro Analityki Sprzedaży DKHSA, nowe stanowisko Managera ds. pricingu&lt;/li&gt;&lt;li&gt;Rada Handlu i Komitet Handlu jako miejsce decyzji cenowych&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;align=left;verticalAlign=top;spacing=10;fontFamily=Helvetica;fontSize=12;fillColor=#E8F5EE;strokeColor=#28794D;fontColor=#183349;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="306" y="370" width="410" height="156" as="geometry"/></mxCell><mxCell id="kontroling_1" value="&lt;ul style='margin:0;padding-left:16px'&gt;&lt;li&gt;Kaskada rabatów poza fakturą: bonifikata 30 zł/t, miesięczna 10–20 zł/t, skonto 40 zł/t, rabat roczny 1,5%&lt;/li&gt;&lt;li&gt;Brak ceny netto i kosztu obsługi per zamówienie, klient i SKU&lt;/li&gt;&lt;li&gt;Usługi wewnątrzgrupowe: zysk jednej spółki bywa kosztem drugiej&lt;/li&gt;&lt;li&gt;Cele liczone na różnych bazach (NPK 42% vs 52%; 585 vs 485 tys. t)&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;align=left;verticalAlign=top;spacing=10;fontFamily=Helvetica;fontSize=12;fillColor=#FDECEC;strokeColor=#B23A3A;fontColor=#183349;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="732" y="370" width="410" height="156" as="geometry"/></mxCell><mxCell id="kontroling_2" value="&lt;ul style='margin:0;padding-left:16px'&gt;&lt;li&gt;Wspólne CO-PA / Margin Analysis dla segmentu, z eliminacjami wewnątrzgrupowymi&lt;/li&gt;&lt;li&gt;Waterfall ceny: od cennika do ceny netto po wszystkich upustach&lt;/li&gt;&lt;li&gt;Jeden rejestr korzyści; CFO zatwierdza efekt każdego etapu&lt;/li&gt;&lt;li&gt;Raport z jednego źródła zamiast zestawień z każdej spółki&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;align=left;verticalAlign=top;spacing=10;fontFamily=Helvetica;fontSize=12;fillColor=#E7F1FA;strokeColor=#286396;fontColor=#183349;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1158" y="370" width="410" height="156" as="geometry"/></mxCell><mxCell id="L_system" value="&lt;b&gt;JEDEN SYSTEM GRUPY&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;SAP + warstwa integracji&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;align=center;verticalAlign=middle;spacing=10;fontFamily=Helvetica;fontSize=14;fillColor=#286396;strokeColor=#286396;fontColor=#FFFFFF;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="540" width="250" height="140" as="geometry"/></mxCell><mxCell id="system_0" value="&lt;ul style='margin:0;padding-left:16px'&gt;&lt;li&gt;Rozbudowany SAP: SD, MM, FI/CO, PP / PP-PI, QM, PM (zakres wg audytu)&lt;/li&gt;&lt;li&gt;Istniejące interfejsy / middleware&lt;/li&gt;&lt;li&gt;Portal AD (kontrakty, dyspozycje)&lt;/li&gt;&lt;li&gt;Automatyka instalacji (OT) w każdym zakładzie&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;align=left;verticalAlign=top;spacing=10;fontFamily=Helvetica;fontSize=12;fillColor=#E8F5EE;strokeColor=#28794D;fontColor=#183349;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="306" y="540" width="410" height="140" as="geometry"/></mxCell><mxCell id="system_1" value="&lt;ul style='margin:0;padding-left:16px'&gt;&lt;li&gt;Plan produkcji w Excelach, osobno w każdym zakładzie&lt;/li&gt;&lt;li&gt;Nie wiadomo, które funkcje SAP są uruchomione i jakie są licencje&lt;/li&gt;&lt;li&gt;Różne kody produktu, opakowania i klienta w spółkach&lt;/li&gt;&lt;li&gt;Moce rzeczywiste nieuzupełnione w dokumentach&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;align=left;verticalAlign=top;spacing=10;fontFamily=Helvetica;fontSize=12;fillColor=#FDECEC;strokeColor=#B23A3A;fontColor=#183349;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="732" y="540" width="410" height="140" as="geometry"/></mxCell><mxCell id="system_2" value="1. Inwentaryzacja: moduły, wersje, interfejsy, licencje&lt;br&gt;2. Jeden szablon procesów i wspólne dane podstawowe dla wszystkich spółek&lt;br&gt;3. Plan 13 tygodni w systemie (IBP / APS, jeśli licencja pozwala); Excel tylko jako widok&lt;br&gt;4. Najpierw użyć tego, co już opłacone; kupować tylko na zidentyfikowaną lukę" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;align=left;verticalAlign=top;spacing=10;fontFamily=Helvetica;fontSize=12;fillColor=#E7F1FA;strokeColor=#286396;fontColor=#183349;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1158" y="540" width="410" height="140" as="geometry"/></mxCell><mxCell id="L_prod" value="&lt;b&gt;PRODUKCJA&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Puławy · Police · Kędzierzyn · Tarnów · Gdańsk · Siarkopol&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;align=center;verticalAlign=middle;spacing=10;fontFamily=Helvetica;fontSize=14;fillColor=#9AA8B4;strokeColor=#9AA8B4;fontColor=#FFFFFF;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="724" width="250" height="124" as="geometry"/></mxCell><mxCell id="prod_0" value="&lt;ul style='margin:0;padding-left:16px'&gt;&lt;li&gt;8,76 mln t/r mocy nawozów, #2 w UE&lt;/li&gt;&lt;li&gt;Wspólne surowce i media, siarka z Siarkopolu, fosfor z Gdańska i Polic&lt;/li&gt;&lt;li&gt;Terminal amoniaku w Policach + tabor Koltar do Puław, Kędzierzyna i Tarnowa&lt;/li&gt;&lt;li&gt;Systemy sterowania instalacji z pomiarami zużycia&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;align=left;verticalAlign=top;spacing=10;fontFamily=Helvetica;fontSize=12;fillColor=#E8F5EE;strokeColor=#28794D;fontColor=#183349;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="306" y="724" width="410" height="124" as="geometry"/></mxCell><mxCell id="prod_1" value="&lt;ul style='margin:0;padding-left:16px'&gt;&lt;li&gt;Wykorzystanie mocy NPK/NP/NS 39% (2024)&lt;/li&gt;&lt;li&gt;Koszt gazu i energii na tonę niewidoczny w planowaniu&lt;/li&gt;&lt;li&gt;Decyzja: produkować NH3 czy importować, podejmowana lokalnie&lt;/li&gt;&lt;li&gt;Remonty niepowiązane z sezonem popytu&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;align=left;verticalAlign=top;spacing=10;fontFamily=Helvetica;fontSize=12;fillColor=#FDECEC;strokeColor=#B23A3A;fontColor=#183349;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="732" y="724" width="410" height="124" as="geometry"/></mxCell><mxCell id="prod_2" value="&lt;ul style='margin:0;padding-left:16px'&gt;&lt;li&gt;Odczyt danych z OT do MES / SAP PP-PI (strefa tylko do odczytu)&lt;/li&gt;&lt;li&gt;Koszt dobrej tony per zakład w jednym widoku&lt;/li&gt;&lt;li&gt;Centrala alokuje produkcję tam, gdzie jest najtaniej i najbliżej klienta&lt;/li&gt;&lt;li&gt;Kalendarz remontów w jednym planie z sezonem&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;align=left;verticalAlign=top;spacing=10;fontFamily=Helvetica;fontSize=12;fillColor=#E7F1FA;strokeColor=#286396;fontColor=#183349;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1158" y="724" width="410" height="124" as="geometry"/></mxCell><mxCell id="L_mag" value="&lt;b&gt;MAGAZYN I PAKOWANIE&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;bufor między fabryką a sezonem&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;align=center;verticalAlign=middle;spacing=10;fontFamily=Helvetica;fontSize=14;fillColor=#9AA8B4;strokeColor=#9AA8B4;fontColor=#FFFFFF;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="862" width="250" height="108" as="geometry"/></mxCell><mxCell id="mag_0" value="&lt;ul style='margin:0;padding-left:16px'&gt;&lt;li&gt;Linie automatycznej paletyzacji: Puławy (2 linie, 1 500 t/d), Police, Kędzierzyn, Tarnów (600 t/d)&lt;/li&gt;&lt;li&gt;Ok. 240 tys. t magazynów wyrobów stałych + 40 tys. t RSM&lt;/li&gt;&lt;li&gt;Planowane: RFID, automatyczne tarowanie wag, terminale samoobsługowe&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;align=left;verticalAlign=top;spacing=10;fontFamily=Helvetica;fontSize=12;fillColor=#E8F5EE;strokeColor=#28794D;fontColor=#183349;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="306" y="862" width="410" height="108" as="geometry"/></mxCell><mxCell id="mag_1" value="&lt;ul style='margin:0;padding-left:16px'&gt;&lt;li&gt;Przeciążeni magazynierzy&lt;/li&gt;&lt;li&gt;Saletra PULAN bez magazynu Big-Bag; bufor granulatu ok. 1 doby&lt;/li&gt;&lt;li&gt;Police M525: 14 tys. t przy 1 gatunku, 8 tys. t przy 4&lt;/li&gt;&lt;li&gt;Brak wspólnego widoku zapasu i partii 4 zakładów&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;align=left;verticalAlign=top;spacing=10;fontFamily=Helvetica;fontSize=12;fillColor=#FDECEC;strokeColor=#B23A3A;fontColor=#183349;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="732" y="862" width="410" height="108" as="geometry"/></mxCell><mxCell id="mag_2" value="&lt;ul style='margin:0;padding-left:16px'&gt;&lt;li&gt;WMS / SAP EWM na tym samym SAP we wszystkich zakładach&lt;/li&gt;&lt;li&gt;Wspólny stan zapasu: gdzie, ile, czyje, jakiej jakości&lt;/li&gt;&lt;li&gt;Plan pakowania na zmianę: towar + opakowania + ludzie&lt;/li&gt;&lt;li&gt;RFID i wagi podpięte do systemu, nie tylko do bramy&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;align=left;verticalAlign=top;spacing=10;fontFamily=Helvetica;fontSize=12;fillColor=#E7F1FA;strokeColor=#286396;fontColor=#183349;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1158" y="862" width="410" height="108" as="geometry"/></mxCell><mxCell id="L_log" value="&lt;b&gt;LOGISTYKA&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Koltar · bocznice · porty&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;align=center;verticalAlign=middle;spacing=10;fontFamily=Helvetica;fontSize=14;fillColor=#9AA8B4;strokeColor=#9AA8B4;fontColor=#FFFFFF;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="984" width="250" height="124" as="geometry"/></mxCell><mxCell id="log_0" value="&lt;ul style='margin:0;padding-left:16px'&gt;&lt;li&gt;GA Koltar jako operator kolejowy Grupy&lt;/li&gt;&lt;li&gt;Ok. 1 700 wagonów i cystern, ponad 175 km bocznic&lt;/li&gt;&lt;li&gt;BBM Gdynia (3 × 9 000 m³), Nabrzeże Chemików w Gdańsku, terminal w Policach&lt;/li&gt;&lt;li&gt;Strategia: Logistyka jako osobny segment, ponad 3 mln t przewozów&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;align=left;verticalAlign=top;spacing=10;fontFamily=Helvetica;fontSize=12;fillColor=#E8F5EE;strokeColor=#28794D;fontColor=#183349;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="306" y="984" width="410" height="124" as="geometry"/></mxCell><mxCell id="log_1" value="&lt;ul style='margin:0;padding-left:16px'&gt;&lt;li&gt;Każdy zakład planuje transport sam&lt;/li&gt;&lt;li&gt;Zależność od taboru PKP Cargo w szczycie&lt;/li&gt;&lt;li&gt;Kolejki aut przy bramach&lt;/li&gt;&lt;li&gt;Puste przebiegi, fracht awaryjny i postoje niezmierzone&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;align=left;verticalAlign=top;spacing=10;fontFamily=Helvetica;fontSize=12;fillColor=#FDECEC;strokeColor=#B23A3A;fontColor=#183349;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="732" y="984" width="410" height="124" as="geometry"/></mxCell><mxCell id="log_2" value="&lt;ul style='margin:0;padding-left:16px'&gt;&lt;li&gt;TMS na wspólnym SAP: jeden plan wagonów i cystern dla całej Grupy&lt;/li&gt;&lt;li&gt;Awizacja aut i kolei połączona z gotowością towaru w WMS&lt;/li&gt;&lt;li&gt;Konsolidacja tras między zakładami&lt;/li&gt;&lt;li&gt;Wolne moce poza sezonem sprzedawane jako usługa zewnętrzna&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;align=left;verticalAlign=top;spacing=10;fontFamily=Helvetica;fontSize=12;fillColor=#E7F1FA;strokeColor=#286396;fontColor=#183349;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1158" y="984" width="410" height="124" as="geometry"/></mxCell><mxCell id="L_rynek" value="&lt;b&gt;RYNEK&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;AD i rolnik&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;align=center;verticalAlign=middle;spacing=10;fontFamily=Helvetica;fontSize=14;fillColor=#28794D;strokeColor=#28794D;fontColor=#FFFFFF;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="1134" width="250" height="96" as="geometry"/></mxCell><mxCell id="rynek_0" value="&lt;ul style='margin:0;padding-left:16px'&gt;&lt;li&gt;68 Autoryzowanych Dystrybutorów, portal AD&lt;/li&gt;&lt;li&gt;Nawozy.eu, menadżerowie rynku w regionach&lt;/li&gt;&lt;li&gt;CRM z profilami agrotechnicznymi gospodarstw&lt;/li&gt;&lt;li&gt;Koncepcja GAia (rekomendacja → koszyk → AD)&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;align=left;verticalAlign=top;spacing=10;fontFamily=Helvetica;fontSize=12;fillColor=#E8F5EE;strokeColor=#28794D;fontColor=#183349;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="306" y="1134" width="410" height="96" as="geometry"/></mxCell><mxCell id="rynek_1" value="&lt;ul style='margin:0;padding-left:16px'&gt;&lt;li&gt;Brak wiedzy o kliencie końcowym&lt;/li&gt;&lt;li&gt;Stany i sprzedaż AD do rolnika nieznane: zapas w kanale wygląda jak popyt&lt;/li&gt;&lt;li&gt;Brak rejestru odmów i utraconych ofert&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;align=left;verticalAlign=top;spacing=10;fontFamily=Helvetica;fontSize=12;fillColor=#FDECEC;strokeColor=#B23A3A;fontColor=#183349;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="732" y="1134" width="410" height="96" as="geometry"/></mxCell><mxCell id="rynek_2" value="&lt;ul style='margin:0;padding-left:16px'&gt;&lt;li&gt;Sell-out AD co tydzień do wspólnego planu&lt;/li&gt;&lt;li&gt;Rejestr odmów w CRM&lt;/li&gt;&lt;li&gt;GAia połączona z realizacją u AD i z planem produkcji&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;align=left;verticalAlign=top;spacing=10;fontFamily=Helvetica;fontSize=12;fillColor=#E7F1FA;strokeColor=#286396;fontColor=#183349;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1158" y="1134" width="410" height="96" as="geometry"/></mxCell><mxCell id="v_centrala" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#183349;strokeWidth=2;fontSize=11;fontColor=#183349;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="L_centrala" target="L_kontroling"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v_kontroling" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#183349;strokeWidth=2;fontSize=11;fontColor=#183349;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="L_kontroling" target="L_system"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v_system" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#183349;strokeWidth=2;fontSize=11;fontColor=#183349;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="L_system" target="L_prod"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v_prod" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#183349;strokeWidth=2;fontSize=11;fontColor=#183349;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="L_prod" target="L_mag"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v_mag" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#183349;strokeWidth=2;fontSize=11;fontColor=#183349;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="L_mag" target="L_log"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v_log" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#183349;strokeWidth=2;fontSize=11;fontColor=#183349;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="L_log" target="L_rynek"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="fb" value="dane rzeczywiste: sprzedaż, odmowy, koszt, marża" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#A96512;strokeWidth=2;fontSize=11;fontColor=#A96512;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="L_rynek" target="L_kontroling"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="14" y="1182.0"/><mxPoint x="14" y="448.0"/></Array></mxGeometry></mxCell><mxCell id="goal" value="&lt;b&gt;Efekt: z ~50% do 60% rynku&lt;/b&gt; (AN/CAN 45→60%, NPK 42→60%) = Grupa sprzedaje jako jedna firma: jeden plan, towar z najtańszego zakładu, dostępny w sezonie, z ceną kontrolowaną przez jeden kontroling" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;align=center;verticalAlign=middle;spacing=10;fontFamily=Helvetica;fontSize=14;fillColor=#183349;strokeColor=#183349;fontColor=#FFFFFF;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="1250" width="1528" height="58" as="geometry"/></mxCell><mxCell id="src" value="Źródła: D1 Strategia GA 2030 (s.17–18), D2 Strategia Nawozowa (slajdy 20–32, 83–96), Mapa zintegrowanego systemu, Matryca wdrożenia (SYSTEMY, LUKI). Warszawa jako siedziba centrali to propozycja, dokumenty mówią o „wzmocnieniu centrali”. Zakres uruchomionych modułów SAP i licencji wymaga potwierdzenia z IT." style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;align=left;verticalAlign=middle;spacing=10;fontFamily=Helvetica;fontSize=11;fillColor=#FFFFFF;strokeColor=#CBD5DF;fontColor=#183349;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="1320" width="1528" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="ga-sap-wms" name="2. Proces - SAP i WMS"><mxGraphModel dx="1800" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1770" pageHeight="840" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;GRUPA AZOTY | Od ~50% do 60% rynku nawozów: proces → SAP / WMS → jedna baza danych&lt;/b&gt;&lt;br&gt;Cel 2030: AN/CAN 45% → 60% (+0,59 mld PLN/rok), NPK 42% → 60% (+0,19 mld PLN/rok)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacing=10;fontFamily=Helvetica;fontSize=16;fillColor=#FFFFFF;strokeColor=#CBD5DF;fontColor=#183349;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1690" height="60" as="geometry"/></mxCell><mxCell id="p0" value="&lt;b&gt;1. Rolnik i dystrybutor (AD)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=center;verticalAlign=middle;spacing=10;fontFamily=Helvetica;fontSize=14;fillColor=#183349;strokeColor=#183349;fontColor=#FFFFFF;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="220" height="50" as="geometry"/></mxCell><mxCell id="p1" value="&lt;b&gt;2. Zamówienie i oferta&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=center;verticalAlign=middle;spacing=10;fontFamily=Helvetica;fontSize=14;fillColor=#183349;strokeColor=#183349;fontColor=#FFFFFF;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="285" y="130" width="220" height="50" as="geometry"/></mxCell><mxCell id="p2" value="&lt;b&gt;3. Plan (4 zakłady)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=center;verticalAlign=middle;spacing=10;fontFamily=Helvetica;fontSize=14;fillColor=#183349;strokeColor=#183349;fontColor=#FFFFFF;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="530" y="130" width="220" height="50" as="geometry"/></mxCell><mxCell id="p3" value="&lt;b&gt;4. Produkcja&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=center;verticalAlign=middle;spacing=10;fontFamily=Helvetica;fontSize=14;fillColor=#183349;strokeColor=#183349;fontColor=#FFFFFF;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="775" y="130" width="220" height="50" as="geometry"/></mxCell><mxCell id="p4" value="&lt;b&gt;5. Magazyn i pakowanie&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=center;verticalAlign=middle;spacing=10;fontFamily=Helvetica;fontSize=14;fillColor=#183349;strokeColor=#183349;fontColor=#FFFFFF;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1020" y="130" width="220" height="50" as="geometry"/></mxCell><mxCell id="p5" value="&lt;b&gt;6. Wysyłka&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=center;verticalAlign=middle;spacing=10;fontFamily=Helvetica;fontSize=14;fillColor=#183349;strokeColor=#183349;fontColor=#FFFFFF;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1265" y="130" width="220" height="50" as="geometry"/></mxCell><mxCell id="p6" value="&lt;b&gt;7. Faktura i gotówka&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=center;verticalAlign=middle;spacing=10;fontFamily=Helvetica;fontSize=14;fillColor=#183349;strokeColor=#183349;fontColor=#FFFFFF;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1510" y="130" width="220" height="50" as="geometry"/></mxCell><mxCell id="pe0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#183349;strokeWidth=2;fontSize=11;fontColor=#536773;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p0" target="p1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="pe1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#183349;strokeWidth=2;fontSize=11;fontColor=#536773;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p1" target="p2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="pe2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#183349;strokeWidth=2;fontSize=11;fontColor=#536773;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p2" target="p3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="pe3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#183349;strokeWidth=2;fontSize=11;fontColor=#536773;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p3" target="p4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="pe4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#183349;strokeWidth=2;fontSize=11;fontColor=#536773;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p4" target="p5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="pe5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#183349;strokeWidth=2;fontSize=11;fontColor=#536773;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p5" target="p6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="fb" value="informacja zwrotna: odbiór, odmowy, sprzedaż AD do rolnika → nowa prognoza" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#A96512;strokeWidth=2;fontSize=11;fontColor=#536773;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" edge="1" parent="1" source="p6" target="p0"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1620.0" y="105"/><mxPoint x="150.0" y="105"/></Array></mxGeometry></mxCell><mxCell id="s0" value="&lt;b&gt;SAP CRM / Sales Cloud + portal AD (GAia)&lt;/b&gt;&lt;ul style='margin:6px 0 6px 0;padding-left:16px'&gt;&lt;li&gt;kontrakty KTR i dyspozycje AD&lt;/li&gt;&lt;li&gt;stany AD i sprzedaż do rolnika (sell-out)&lt;/li&gt;&lt;li&gt;oferty utracone + powód odmowy&lt;/li&gt;&lt;li&gt;GAia: program nawożenia → koszyk → AD&lt;/li&gt;&lt;/ul&gt;&lt;font color='#A96512'&gt;&lt;b&gt;→ udział:&lt;/b&gt; wiemy, co, gdzie i kiedy kupi rolnik&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacing=10;fontFamily=Helvetica;fontSize=12;fillColor=#E7F1FA;strokeColor=#286396;fontColor=#183349;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="220" width="220" height="300" as="geometry"/></mxCell><mxCell id="ps0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#536773;strokeWidth=2;fontSize=11;fontColor=#536773;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p0" target="s0"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sc0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#A96512;strokeWidth=2;fontSize=11;fontColor=#536773;labelBackgroundColor=#FFFFFF;dashed=1;startArrow=block;startFill=1;exitX=0.5;exitY=1;entryX=0.0650887573964497;entryY=0;" edge="1" parent="1" source="s0" target="core"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s1" value="&lt;b&gt;SAP SD&lt;/b&gt;&lt;ul style='margin:6px 0 6px 0;padding-left:16px'&gt;&lt;li&gt;cennik i rabaty w jednym miejscu (bez kaskady poza fakturą)&lt;/li&gt;&lt;li&gt;ATP: termin potwierdzany na realnym zapasie i planie&lt;/li&gt;&lt;li&gt;limit kredytowy klienta&lt;/li&gt;&lt;li&gt;rezerwa SPOT 10–15% wolumenu&lt;/li&gt;&lt;/ul&gt;&lt;font color='#A96512'&gt;&lt;b&gt;→ udział:&lt;/b&gt; szybka i pewna odpowiedź dla AD&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacing=10;fontFamily=Helvetica;fontSize=12;fillColor=#E7F1FA;strokeColor=#286396;fontColor=#183349;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="285" y="220" width="220" height="300" as="geometry"/></mxCell><mxCell id="ps1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#536773;strokeWidth=2;fontSize=11;fontColor=#536773;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p1" target="s1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sc1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#A96512;strokeWidth=2;fontSize=11;fontColor=#536773;labelBackgroundColor=#FFFFFF;dashed=1;startArrow=block;startFill=1;exitX=0.5;exitY=1;entryX=0.21005917159763313;entryY=0;" edge="1" parent="1" source="s1" target="core"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s2" value="&lt;b&gt;SAP IBP (S&amp;amp;OP) + PP/DS&lt;/b&gt;&lt;ul style='margin:6px 0 6px 0;padding-left:16px'&gt;&lt;li&gt;prognoza z sell-out, nie tylko z zamówień&lt;/li&gt;&lt;li&gt;bilans popyt–podaż dla Puław, Polic, Tarnowa, Kędzierzyna&lt;/li&gt;&lt;li&gt;plan 13 tygodni zamiast Excela&lt;/li&gt;&lt;li&gt;ograniczenia: magazyn, pakowanie, transport&lt;/li&gt;&lt;/ul&gt;&lt;font color='#A96512'&gt;&lt;b&gt;→ udział:&lt;/b&gt; towar gotowy przed szczytem sezonu&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacing=10;fontFamily=Helvetica;fontSize=12;fillColor=#E7F1FA;strokeColor=#286396;fontColor=#183349;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="530" y="220" width="220" height="300" as="geometry"/></mxCell><mxCell id="ps2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#536773;strokeWidth=2;fontSize=11;fontColor=#536773;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p2" target="s2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sc2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#A96512;strokeWidth=2;fontSize=11;fontColor=#536773;labelBackgroundColor=#FFFFFF;dashed=1;startArrow=block;startFill=1;exitX=0.5;exitY=1;entryX=0.35502958579881655;entryY=0;" edge="1" parent="1" source="s2" target="core"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s3" value="&lt;b&gt;SAP PP-PI + PM + QM (+ MES)&lt;/b&gt;&lt;ul style='margin:6px 0 6px 0;padding-left:16px'&gt;&lt;li&gt;zlecenia procesowe i receptury&lt;/li&gt;&lt;li&gt;remonty planowane poza sezonem&lt;/li&gt;&lt;li&gt;zwolnienie jakościowe partii&lt;/li&gt;&lt;li&gt;gaz i energia na dobrą tonę (dane z OT)&lt;/li&gt;&lt;/ul&gt;&lt;font color='#A96512'&gt;&lt;b&gt;→ udział:&lt;/b&gt; niższy koszt tony = cena lepsza niż import&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacing=10;fontFamily=Helvetica;fontSize=12;fillColor=#E7F1FA;strokeColor=#286396;fontColor=#183349;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="775" y="220" width="220" height="300" as="geometry"/></mxCell><mxCell id="ps3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#536773;strokeWidth=2;fontSize=11;fontColor=#536773;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p3" target="s3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sc3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#A96512;strokeWidth=2;fontSize=11;fontColor=#536773;labelBackgroundColor=#FFFFFF;dashed=1;startArrow=block;startFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s3" target="core"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s4" value="&lt;b&gt;WMS / SAP EWM&lt;/b&gt;&lt;ul style='margin:6px 0 6px 0;padding-left:16px'&gt;&lt;li&gt;lokalizacje, partie, skanery RF&lt;/li&gt;&lt;li&gt;zadania i kolejność kompletacji / załadunku&lt;/li&gt;&lt;li&gt;plan pakowania na zmianę (ludzie + opakowania)&lt;/li&gt;&lt;li&gt;pomiar pracy (Labor Management)&lt;/li&gt;&lt;li&gt;MFS → przenośniki, paletyzacja, owijanie&lt;/li&gt;&lt;/ul&gt;&lt;font color='#A96512'&gt;&lt;b&gt;→ udział:&lt;/b&gt; więcej ton wydanych w oknie sezonu&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacing=10;fontFamily=Helvetica;fontSize=12;fillColor=#E8F5EE;strokeColor=#28794D;fontColor=#183349;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1020" y="220" width="220" height="300" as="geometry"/></mxCell><mxCell id="ps4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#536773;strokeWidth=2;fontSize=11;fontColor=#536773;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p4" target="s4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sc4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#A96512;strokeWidth=2;fontSize=11;fontColor=#536773;labelBackgroundColor=#FFFFFF;dashed=1;startArrow=block;startFill=1;exitX=0.5;exitY=1;entryX=0.6449704142011834;entryY=0;" edge="1" parent="1" source="s4" target="core"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s5" value="&lt;b&gt;SAP TM + EWM Yard / awizacja&lt;/b&gt;&lt;ul style='margin:6px 0 6px 0;padding-left:16px'&gt;&lt;li&gt;okna załadunku dla aut i wagonów&lt;/li&gt;&lt;li&gt;integracja wag i bram&lt;/li&gt;&lt;li&gt;obieg cystern RSM, zbiorniki u AD&lt;/li&gt;&lt;li&gt;Koltar: konsolidacja tras, usługi poza sezonem&lt;/li&gt;&lt;/ul&gt;&lt;font color='#A96512'&gt;&lt;b&gt;→ udział:&lt;/b&gt; dostawa na czas, bez kolejek&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacing=10;fontFamily=Helvetica;fontSize=12;fillColor=#E8F5EE;strokeColor=#28794D;fontColor=#183349;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1265" y="220" width="220" height="300" as="geometry"/></mxCell><mxCell id="ps5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#536773;strokeWidth=2;fontSize=11;fontColor=#536773;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p5" target="s5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sc5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#A96512;strokeWidth=2;fontSize=11;fontColor=#536773;labelBackgroundColor=#FFFFFF;dashed=1;startArrow=block;startFill=1;exitX=0.5;exitY=1;entryX=0.7899408284023669;entryY=0;" edge="1" parent="1" source="s5" target="core"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s6" value="&lt;b&gt;SAP FI/CO + CO-PA&lt;/b&gt;&lt;ul style='margin:6px 0 6px 0;padding-left:16px'&gt;&lt;li&gt;faktura z potwierdzenia odbioru&lt;/li&gt;&lt;li&gt;marża per klient / SKU po rabatach i dostawie&lt;/li&gt;&lt;li&gt;należności i zapas = gotówka na sezon&lt;/li&gt;&lt;/ul&gt;&lt;font color='#A96512'&gt;&lt;b&gt;→ udział:&lt;/b&gt; wiemy, który wolumen się opłaca&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacing=10;fontFamily=Helvetica;fontSize=12;fillColor=#E7F1FA;strokeColor=#286396;fontColor=#183349;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1510" y="220" width="220" height="300" as="geometry"/></mxCell><mxCell id="ps6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#536773;strokeWidth=2;fontSize=11;fontColor=#536773;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p6" target="s6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sc6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#A96512;strokeWidth=2;fontSize=11;fontColor=#536773;labelBackgroundColor=#FFFFFF;dashed=1;startArrow=block;startFill=1;exitX=0.5;exitY=1;entryX=0.9349112426035503;entryY=0;" edge="1" parent="1" source="s6" target="core"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="core" value="&lt;b&gt;SAP S/4HANA = JEDNA BAZA DANYCH&lt;/b&gt; (zapis: zamówienie → zlecenie → partia → dostawa → faktura → marża)&lt;br&gt;Wspólne dane podstawowe: produkt, opakowanie, klient, lokalizacja, jednostka miary &amp;nbsp;|&amp;nbsp; Integration Suite / IDoc / API do portalu AD, GAia, MES, wag i automatyki &amp;nbsp;|&amp;nbsp; BI / SAP Analytics Cloud: jeden raport marży, planu i zapasu &amp;nbsp;|&amp;nbsp; Excel tylko jako widok, nie osobna baza" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacing=10;fontFamily=Helvetica;fontSize=13;fillColor=#FFF1DF;strokeColor=#A96512;fontColor=#183349;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="570" width="1690" height="95" as="geometry"/></mxCell><mxCell id="goal" value="&lt;b&gt;Efekt: 50% → 60% rynku&lt;/b&gt; = towar dostępny tam i wtedy, gdy rolnik kupuje (pkt 1, 3, 5, 6) + oferta z wartością i kontrolą rabatu (pkt 1, 2, 7) + koszt tony konkurencyjny z importem (pkt 4)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=center;verticalAlign=middle;spacing=10;fontFamily=Helvetica;fontSize=14;fillColor=#183349;strokeColor=#183349;fontColor=#FFFFFF;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="695" width="1690" height="55" as="geometry"/></mxCell><mxCell id="leg" value="Legenda: &lt;font color='#286396'&gt;&lt;b&gt;niebieski&lt;/b&gt;&lt;/font&gt; = moduł SAP, &lt;font color='#28794D'&gt;&lt;b&gt;zielony&lt;/b&gt;&lt;/font&gt; = WMS / magazyn i wysyłka, linia ciągła = przepływ procesu, linia przerywana = wymiana danych z bazą. Kolejność: 2026/27 uporządkować dane podstawowe i spis modułów SAP → 2027 pilot z AD (sell-out do IBP) → 2028–30 EWM, TM, MES i GAia w skali." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=middle;spacing=10;fontFamily=Helvetica;fontSize=11;fillColor=#FFFFFF;strokeColor=#CBD5DF;fontColor=#183349;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="770" width="1690" height="34" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>