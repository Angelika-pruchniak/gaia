<mxfile host="app.diagrams.net"><diagram id="ga-sap-wms" name="SAP i WMS - droga do 60%"><mxGraphModel dx="1800" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1770" pageHeight="840" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;GRUPA AZOTY | Od ~50% do 60% rynku nawozów: proces → SAP / WMS → jedna baza danych&lt;/b&gt;&lt;br&gt;Cel 2030: AN/CAN 45% → 60% (+0,59 mld PLN/rok), NPK 42% → 60% (+0,19 mld PLN/rok)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacing=10;fontFamily=Helvetica;fontSize=16;fillColor=#FFFFFF;strokeColor=#CBD5DF;fontColor=#183349;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1690" height="60" as="geometry"/></mxCell><mxCell id="p0" value="&lt;b&gt;1. Rolnik i dystrybutor (AD)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=center;verticalAlign=middle;spacing=10;fontFamily=Helvetica;fontSize=14;fillColor=#183349;strokeColor=#183349;fontColor=#FFFFFF;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="220" height="50" as="geometry"/></mxCell><mxCell id="p1" value="&lt;b&gt;2. Zamówienie i oferta&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=center;verticalAlign=middle;spacing=10;fontFamily=Helvetica;fontSize=14;fillColor=#183349;strokeColor=#183349;fontColor=#FFFFFF;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="285" y="130" width="220" height="50" as="geometry"/></mxCell><mxCell id="p2" value="&lt;b&gt;3. Plan (4 zakłady)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=center;verticalAlign=middle;spacing=10;fontFamily=Helvetica;fontSize=14;fillColor=#183349;strokeColor=#183349;fontColor=#FFFFFF;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="530" y="130" width="220" height="50" as="geometry"/></mxCell><mxCell id="p3" value="&lt;b&gt;4. Produkcja&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=center;verticalAlign=middle;spacing=10;fontFamily=Helvetica;fontSize=14;fillColor=#183349;strokeColor=#183349;fontColor=#FFFFFF;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="775" y="130" width="220" height="50" as="geometry"/></mxCell><mxCell id="p4" value="&lt;b&gt;5. Magazyn i pakowanie&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=center;verticalAlign=middle;spacing=10;fontFamily=Helvetica;fontSize=14;fillColor=#183349;strokeColor=#183349;fontColor=#FFFFFF;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1020" y="130" width="220" height="50" as="geometry"/></mxCell><mxCell id="p5" value="&lt;b&gt;6. Wysyłka&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=center;verticalAlign=middle;spacing=10;fontFamily=Helvetica;fontSize=14;fillColor=#183349;strokeColor=#183349;fontColor=#FFFFFF;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1265" y="130" width="220" height="50" as="geometry"/></mxCell><mxCell id="p6" value="&lt;b&gt;7. Faktura i gotówka&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=center;verticalAlign=middle;spacing=10;fontFamily=Helvetica;fontSize=14;fillColor=#183349;strokeColor=#183349;fontColor=#FFFFFF;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1510" y="130" width="220" height="50" as="geometry"/></mxCell><mxCell id="pe0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#183349;strokeWidth=2;fontSize=11;fontColor=#536773;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p0" target="p1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="pe1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#183349;strokeWidth=2;fontSize=11;fontColor=#536773;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p1" target="p2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="pe2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#183349;strokeWidth=2;fontSize=11;fontColor=#536773;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p2" target="p3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="pe3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#183349;strokeWidth=2;fontSize=11;fontColor=#536773;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p3" target="p4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="pe4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#183349;strokeWidth=2;fontSize=11;fontColor=#536773;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p4" target="p5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="pe5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#183349;strokeWidth=2;fontSize=11;fontColor=#536773;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p5" target="p6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="fb" value="informacja zwrotna: odbiór, odmowy, sprzedaż AD do rolnika → nowa prognoza" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#A96512;strokeWidth=2;fontSize=11;fontColor=#536773;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" edge="1" parent="1" source="p6" target="p0"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1620.0" y="105"/><mxPoint x="150.0" y="105"/></Array></mxGeometry></mxCell><mxCell id="s0" value="&lt;b&gt;SAP CRM / Sales Cloud + portal AD (GAia)&lt;/b&gt;&lt;ul style='margin:6px 0 6px 0;padding-left:16px'&gt;&lt;li&gt;kontrakty KTR i dyspozycje AD&lt;/li&gt;&lt;li&gt;stany AD i sprzedaż do rolnika (sell-out)&lt;/li&gt;&lt;li&gt;oferty utracone + powód odmowy&lt;/li&gt;&lt;li&gt;GAia: program nawożenia → koszyk → AD&lt;/li&gt;&lt;/ul&gt;&lt;font color='#A96512'&gt;&lt;b&gt;→ udział:&lt;/b&gt; wiemy, co, gdzie i kiedy kupi rolnik&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacing=10;fontFamily=Helvetica;fontSize=12;fillColor=#E7F1FA;strokeColor=#286396;fontColor=#183349;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="220" width="220" height="300" as="geometry"/></mxCell><mxCell id="ps0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#536773;strokeWidth=2;fontSize=11;fontColor=#536773;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p0" target="s0"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sc0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#A96512;strokeWidth=2;fontSize=11;fontColor=#536773;labelBackgroundColor=#FFFFFF;dashed=1;startArrow=block;startFill=1;exitX=0.5;exitY=1;entryX=0.0650887573964497;entryY=0;" edge="1" parent="1" source="s0" target="core"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s1" value="&lt;b&gt;SAP SD&lt;/b&gt;&lt;ul style='margin:6px 0 6px 0;padding-left:16px'&gt;&lt;li&gt;cennik i rabaty w jednym miejscu (bez kaskady poza fakturą)&lt;/li&gt;&lt;li&gt;ATP: termin potwierdzany na realnym zapasie i planie&lt;/li&gt;&lt;li&gt;limit kredytowy klienta&lt;/li&gt;&lt;li&gt;rezerwa SPOT 10–15% wolumenu&lt;/li&gt;&lt;/ul&gt;&lt;font color='#A96512'&gt;&lt;b&gt;→ udział:&lt;/b&gt; szybka i pewna odpowiedź dla AD&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacing=10;fontFamily=Helvetica;fontSize=12;fillColor=#E7F1FA;strokeColor=#286396;fontColor=#183349;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="285" y="220" width="220" height="300" as="geometry"/></mxCell><mxCell id="ps1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#536773;strokeWidth=2;fontSize=11;fontColor=#536773;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p1" target="s1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sc1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#A96512;strokeWidth=2;fontSize=11;fontColor=#536773;labelBackgroundColor=#FFFFFF;dashed=1;startArrow=block;startFill=1;exitX=0.5;exitY=1;entryX=0.21005917159763313;entryY=0;" edge="1" parent="1" source="s1" target="core"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s2" value="&lt;b&gt;SAP IBP (S&amp;amp;OP) + PP/DS&lt;/b&gt;&lt;ul style='margin:6px 0 6px 0;padding-left:16px'&gt;&lt;li&gt;prognoza z sell-out, nie tylko z zamówień&lt;/li&gt;&lt;li&gt;bilans popyt–podaż dla Puław, Polic, Tarnowa, Kędzierzyna&lt;/li&gt;&lt;li&gt;plan 13 tygodni zamiast Excela&lt;/li&gt;&lt;li&gt;ograniczenia: magazyn, pakowanie, transport&lt;/li&gt;&lt;/ul&gt;&lt;font color='#A96512'&gt;&lt;b&gt;→ udział:&lt;/b&gt; towar gotowy przed szczytem sezonu&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacing=10;fontFamily=Helvetica;fontSize=12;fillColor=#E7F1FA;strokeColor=#286396;fontColor=#183349;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="530" y="220" width="220" height="300" as="geometry"/></mxCell><mxCell id="ps2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#536773;strokeWidth=2;fontSize=11;fontColor=#536773;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p2" target="s2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sc2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#A96512;strokeWidth=2;fontSize=11;fontColor=#536773;labelBackgroundColor=#FFFFFF;dashed=1;startArrow=block;startFill=1;exitX=0.5;exitY=1;entryX=0.35502958579881655;entryY=0;" edge="1" parent="1" source="s2" target="core"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s3" value="&lt;b&gt;SAP PP-PI + PM + QM (+ MES)&lt;/b&gt;&lt;ul style='margin:6px 0 6px 0;padding-left:16px'&gt;&lt;li&gt;zlecenia procesowe i receptury&lt;/li&gt;&lt;li&gt;remonty planowane poza sezonem&lt;/li&gt;&lt;li&gt;zwolnienie jakościowe partii&lt;/li&gt;&lt;li&gt;gaz i energia na dobrą tonę (dane z OT)&lt;/li&gt;&lt;/ul&gt;&lt;font color='#A96512'&gt;&lt;b&gt;→ udział:&lt;/b&gt; niższy koszt tony = cena lepsza niż import&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacing=10;fontFamily=Helvetica;fontSize=12;fillColor=#E7F1FA;strokeColor=#286396;fontColor=#183349;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="775" y="220" width="220" height="300" as="geometry"/></mxCell><mxCell id="ps3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#536773;strokeWidth=2;fontSize=11;fontColor=#536773;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p3" target="s3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sc3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#A96512;strokeWidth=2;fontSize=11;fontColor=#536773;labelBackgroundColor=#FFFFFF;dashed=1;startArrow=block;startFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s3" target="core"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s4" value="&lt;b&gt;WMS / SAP EWM&lt;/b&gt;&lt;ul style='margin:6px 0 6px 0;padding-left:16px'&gt;&lt;li&gt;lokalizacje, partie, skanery RF&lt;/li&gt;&lt;li&gt;zadania i kolejność kompletacji / załadunku&lt;/li&gt;&lt;li&gt;plan pakowania na zmianę (ludzie + opakowania)&lt;/li&gt;&lt;li&gt;pomiar pracy (Labor Management)&lt;/li&gt;&lt;li&gt;MFS → przenośniki, paletyzacja, owijanie&lt;/li&gt;&lt;/ul&gt;&lt;font color='#A96512'&gt;&lt;b&gt;→ udział:&lt;/b&gt; więcej ton wydanych w oknie sezonu&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacing=10;fontFamily=Helvetica;fontSize=12;fillColor=#E8F5EE;strokeColor=#28794D;fontColor=#183349;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1020" y="220" width="220" height="300" as="geometry"/></mxCell><mxCell id="ps4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#536773;strokeWidth=2;fontSize=11;fontColor=#536773;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p4" target="s4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sc4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#A96512;strokeWidth=2;fontSize=11;fontColor=#536773;labelBackgroundColor=#FFFFFF;dashed=1;startArrow=block;startFill=1;exitX=0.5;exitY=1;entryX=0.6449704142011834;entryY=0;" edge="1" parent="1" source="s4" target="core"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s5" value="&lt;b&gt;SAP TM + EWM Yard / awizacja&lt;/b&gt;&lt;ul style='margin:6px 0 6px 0;padding-left:16px'&gt;&lt;li&gt;okna załadunku dla aut i wagonów&lt;/li&gt;&lt;li&gt;integracja wag i bram&lt;/li&gt;&lt;li&gt;obieg cystern RSM, zbiorniki u AD&lt;/li&gt;&lt;li&gt;Koltar: konsolidacja tras, usługi poza sezonem&lt;/li&gt;&lt;/ul&gt;&lt;font color='#A96512'&gt;&lt;b&gt;→ udział:&lt;/b&gt; dostawa na czas, bez kolejek&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacing=10;fontFamily=Helvetica;fontSize=12;fillColor=#E8F5EE;strokeColor=#28794D;fontColor=#183349;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1265" y="220" width="220" height="300" as="geometry"/></mxCell><mxCell id="ps5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#536773;strokeWidth=2;fontSize=11;fontColor=#536773;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p5" target="s5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sc5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#A96512;strokeWidth=2;fontSize=11;fontColor=#536773;labelBackgroundColor=#FFFFFF;dashed=1;startArrow=block;startFill=1;exitX=0.5;exitY=1;entryX=0.7899408284023669;entryY=0;" edge="1" parent="1" source="s5" target="core"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s6" value="&lt;b&gt;SAP FI/CO + CO-PA&lt;/b&gt;&lt;ul style='margin:6px 0 6px 0;padding-left:16px'&gt;&lt;li&gt;faktura z potwierdzenia odbioru&lt;/li&gt;&lt;li&gt;marża per klient / SKU po rabatach i dostawie&lt;/li&gt;&lt;li&gt;należności i zapas = gotówka na sezon&lt;/li&gt;&lt;/ul&gt;&lt;font color='#A96512'&gt;&lt;b&gt;→ udział:&lt;/b&gt; wiemy, który wolumen się opłaca&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacing=10;fontFamily=Helvetica;fontSize=12;fillColor=#E7F1FA;strokeColor=#286396;fontColor=#183349;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1510" y="220" width="220" height="300" as="geometry"/></mxCell><mxCell id="ps6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#536773;strokeWidth=2;fontSize=11;fontColor=#536773;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p6" target="s6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sc6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#A96512;strokeWidth=2;fontSize=11;fontColor=#536773;labelBackgroundColor=#FFFFFF;dashed=1;startArrow=block;startFill=1;exitX=0.5;exitY=1;entryX=0.9349112426035503;entryY=0;" edge="1" parent="1" source="s6" target="core"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="core" value="&lt;b&gt;SAP S/4HANA = JEDNA BAZA DANYCH&lt;/b&gt; (zapis: zamówienie → zlecenie → partia → dostawa → faktura → marża)&lt;br&gt;Wspólne dane podstawowe: produkt, opakowanie, klient, lokalizacja, jednostka miary &amp;nbsp;|&amp;nbsp; Integration Suite / IDoc / API do portalu AD, GAia, MES, wag i automatyki &amp;nbsp;|&amp;nbsp; BI / SAP Analytics Cloud: jeden raport marży, planu i zapasu &amp;nbsp;|&amp;nbsp; Excel tylko jako widok, nie osobna baza" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacing=10;fontFamily=Helvetica;fontSize=13;fillColor=#FFF1DF;strokeColor=#A96512;fontColor=#183349;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="570" width="1690" height="95" as="geometry"/></mxCell><mxCell id="goal" value="&lt;b&gt;Efekt: 50% → 60% rynku&lt;/b&gt; = towar dostępny tam i wtedy, gdy rolnik kupuje (pkt 1, 3, 5, 6) + oferta z wartością i kontrolą rabatu (pkt 1, 2, 7) + koszt tony konkurencyjny z importem (pkt 4)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=center;verticalAlign=middle;spacing=10;fontFamily=Helvetica;fontSize=14;fillColor=#183349;strokeColor=#183349;fontColor=#FFFFFF;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="695" width="1690" height="55" as="geometry"/></mxCell><mxCell id="leg" value="Legenda: &lt;font color='#286396'&gt;&lt;b&gt;niebieski&lt;/b&gt;&lt;/font&gt; = moduł SAP, &lt;font color='#28794D'&gt;&lt;b&gt;zielony&lt;/b&gt;&lt;/font&gt; = WMS / magazyn i wysyłka, linia ciągła = przepływ procesu, linia przerywana = wymiana danych z bazą. Kolejność: 2026/27 uporządkować dane podstawowe i spis modułów SAP → 2027 pilot z AD (sell-out do IBP) → 2028–30 EWM, TM, MES i GAia w skali." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=middle;spacing=10;fontFamily=Helvetica;fontSize=11;fillColor=#FFFFFF;strokeColor=#CBD5DF;fontColor=#183349;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="770" width="1690" height="34" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>